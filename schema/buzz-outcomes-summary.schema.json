{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zirqo-dev.github.io/sightline/schema/buzz-outcomes-summary.schema.json",
  "title": "Buzz outcomes summary",
  "description": "Counts and hit rates for scored buzz spikes, grouped by author pattern, spike kind, and chain. Research tally only. buy_signal and veto are false. Rates are null while the sample is small.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "measured_factor", "buy_signal", "veto",
    "asof", "min_sample", "up_pct", "note", "definitions",
    "totals", "excluded_reasons", "groups"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "buzz_outcomes_summary"},
    "measured_factor": {"const": true},
    "buy_signal": {"const": false},
    "veto": {"const": false},
    "asof": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "min_sample": {"type": "integer", "minimum": 1},
    "up_pct": {"type": "number", "minimum": 0},
    "note": {"type": "string", "minLength": 1, "maxLength": 200},
    "definitions": {"$ref": "#/$defs/definitions"},
    "totals": {"$ref": "#/$defs/totals"},
    "excluded_reasons": {"$ref": "#/$defs/excluded_reasons"},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}}
  },
  "$defs": {
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spike", "few_authors", "many_authors", "zero_start", "ratio",
        "up_24h", "adverse", "small_sample", "windows", "file"
      ],
      "properties": {
        "spike": {"type": "string", "minLength": 1, "maxLength": 240},
        "few_authors": {"type": "string", "minLength": 1, "maxLength": 240},
        "many_authors": {"type": "string", "minLength": 1, "maxLength": 240},
        "zero_start": {"type": "string", "minLength": 1, "maxLength": 240},
        "ratio": {"type": "string", "minLength": 1, "maxLength": 240},
        "up_24h": {"type": "string", "minLength": 1, "maxLength": 240},
        "adverse": {"type": "string", "minLength": 1, "maxLength": 240},
        "small_sample": {"type": "string", "minLength": 1, "maxLength": 240},
        "windows": {"type": "string", "minLength": 1, "maxLength": 240},
        "file": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "scored", "excluded"],
      "properties": {
        "events": {"type": "integer", "minimum": 0},
        "scored": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0}
      }
    },
    "excluded_reasons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low_confidence", "collision_ticker"],
      "properties": {
        "low_confidence": {"type": "integer", "minimum": 0},
        "collision_ticker": {"type": "integer", "minimum": 0}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by", "pattern", "n", "small_sample",
        "n_h24_priced", "n_h24_up", "up_24h_rate", "up_24h_reason",
        "n_adverse_known", "n_adverse", "adverse_rate", "adverse_reason"
      ],
      "properties": {
        "by": {"enum": ["author_pattern", "spike_kind", "chain", "combined"]},
        "pattern": {"type": "string", "minLength": 1, "maxLength": 80},
        "n": {"type": "integer", "minimum": 0},
        "small_sample": {"type": "boolean"},
        "n_h24_priced": {"type": "integer", "minimum": 0},
        "n_h24_up": {"type": "integer", "minimum": 0},
        "up_24h_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "up_24h_reason": {"type": ["string", "null"], "enum": ["small_sample", null]},
        "n_adverse_known": {"type": "integer", "minimum": 0},
        "n_adverse": {"type": "integer", "minimum": 0},
        "adverse_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "adverse_reason": {"type": ["string", "null"], "enum": ["small_sample", null]}
      }
    }
  }
}
