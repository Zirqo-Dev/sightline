{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zirqo-dev.github.io/sightline/schema/v2-manifest.schema.json",
  "title": "Solana desk v2 universe manifest line",
  "description": "One solana-desk/v2/manifest-YYYYMMDD.jsonl line. Logging only. A scan header or one candidate mint. Not an entry, exit, or skip.",
  "oneOf": [
    {"$ref": "#/$defs/scan"},
    {"$ref": "#/$defs/candidate"}
  ],
  "$defs": {
    "mint": {"type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"},
    "iso": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "scanId": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{4}$"},
    "num": {"type": ["number", "null"]},
    "rule": {"enum": ["pass", "fail", "unknown"]},
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "v", "scan_id", "t", "t_s", "sources", "source_pages", "pre_filters", "page_limits",
        "candidates_seen", "candidates_selected", "pool_lookups_attempted", "pool_lookups_failed",
        "pool_lookups", "g5_rate", "rug_lookups_attempted", "rug_lookups_failed", "rug_fail_rate",
        "extra_calls", "extra_call_cap", "follow_budget_s", "follow_skipped_budget", "follow_stop",
        "snap_files", "s2_picks", "twin_candidates", "twin_draws", "log_errors", "s2_thresholds"
      ],
      "properties": {
        "type": {"const": "scan"},
        "v": {"const": 1},
        "scan_id": {"$ref": "#/$defs/scanId"},
        "t": {"$ref": "#/$defs/iso"},
        "t_s": {"type": "integer"},
        "sources": {"type": "array", "items": {"type": "string", "maxLength": 80}},
        "source_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "path", "status", "fetched_at", "fetched_at_s", "rows"],
            "properties": {
              "source": {"type": "string", "maxLength": 40},
              "path": {"type": "string", "maxLength": 80},
              "status": {"enum": ["ok", "failed", "429"]},
              "fetched_at": {"$ref": "#/$defs/iso"},
              "fetched_at_s": {"type": "integer"},
              "rows": {"type": "integer", "minimum": 0}
            }
          }
        },
        "pre_filters": {"type": "array", "items": {"type": "string", "maxLength": 80}},
        "page_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["leads_per_run", "pages_per_source"],
          "properties": {
            "leads_per_run": {"type": "integer", "minimum": 0},
            "pages_per_source": {"type": "integer", "minimum": 1}
          }
        },
        "candidates_seen": {"type": "integer", "minimum": 0},
        "candidates_selected": {"type": "integer", "minimum": 0},
        "pool_lookups_attempted": {"type": "integer", "minimum": 0},
        "pool_lookups_failed": {"type": "integer", "minimum": 0},
        "pool_lookups": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scan_attempted", "scan_failed", "extra_attempted", "extra_failed"],
          "properties": {
            "scan_attempted": {"type": "integer", "minimum": 0},
            "scan_failed": {"type": "integer", "minimum": 0},
            "extra_attempted": {"type": "integer", "minimum": 0},
            "extra_failed": {"type": "integer", "minimum": 0}
          }
        },
        "g5_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "rug_lookups_attempted": {"type": "integer", "minimum": 0},
        "rug_lookups_failed": {"type": "integer", "minimum": 0},
        "rug_fail_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "extra_calls": {"type": "integer", "minimum": 0},
        "extra_call_cap": {"type": "integer", "minimum": 0},
        "follow_budget_s": {"type": "number", "minimum": 0},
        "follow_skipped_budget": {"type": "integer", "minimum": 0},
        "follow_stop": {"enum": ["cap", "budget", "429", null]},
        "snap_files": {"type": "array", "items": {"type": "string", "maxLength": 80}},
        "s2_picks": {"type": "array", "items": {"$ref": "#/$defs/mint"}},
        "twin_candidates": {"type": "array", "items": {"$ref": "#/$defs/mint"}},
        "twin_draws": {"type": "null"},
        "log_errors": {"type": "integer", "minimum": 0},
        "s2_thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_age_s", "min_sol", "min_trades_h1", "min_sells_h1", "max_top10_pct", "max_dev_pct", "max_k_drop", "authority_rule"],
          "properties": {
            "min_age_s": {"type": "integer"},
            "min_sol": {"type": "number"},
            "min_trades_h1": {"type": "integer"},
            "min_sells_h1": {"type": "integer"},
            "max_top10_pct": {"type": "number"},
            "max_dev_pct": {"type": "number"},
            "max_k_drop": {"type": "number"},
            "authority_rule": {"const": true}
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "v", "scan_id", "t", "t_s", "mint", "source", "seen_index", "selected",
        "pool_lookup", "pair_fetched_at", "rug_fetched_at", "inputs", "reserve", "rules",
        "k_series_n", "k_last", "k_max_drop", "snap_stems", "first_pick"
      ],
      "properties": {
        "type": {"const": "candidate"},
        "v": {"const": 1},
        "scan_id": {"$ref": "#/$defs/scanId"},
        "t": {"$ref": "#/$defs/iso"},
        "t_s": {"type": "integer"},
        "mint": {"$ref": "#/$defs/mint"},
        "source": {"enum": ["token-profiles", "token-boosts"]},
        "seen_index": {"type": "integer", "minimum": 0},
        "selected": {"type": "boolean"},
        "pool_lookup": {"enum": ["ok", "failed", "no_pair", "not_attempted"]},
        "pair_fetched_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "rug_fetched_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "inputs": {"$ref": "#/$defs/inputs"},
        "reserve": {"type": ["object", "null"], "additionalProperties": false,
          "required": ["sol", "token", "k", "pool", "t", "t_s"],
          "properties": {
            "sol": {"$ref": "#/$defs/num"}, "token": {"$ref": "#/$defs/num"}, "k": {"$ref": "#/$defs/num"},
            "pool": {"type": ["string", "null"], "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"},
            "t": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
            "t_s": {"type": ["integer", "null"]}
          }
        },
        "k_series_n": {"type": "integer", "minimum": 0},
        "k_last": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["t_s", "k", "pool"],
          "properties": {
            "t_s": {"type": ["integer", "null"]},
            "k": {"$ref": "#/$defs/num"},
            "pool": {"type": ["string", "null"], "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"}
          }
        },
        "k_max_drop": {"$ref": "#/$defs/num"},
        "snap_stems": {"type": "array", "items": {"type": "string", "maxLength": 80}},
        "first_pick": {"type": "boolean"},
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["graduated_age", "sol_reserve", "activity_h1", "holders", "k_stable", "authorities"],
          "properties": {
            "graduated_age": {"$ref": "#/$defs/rule"},
            "sol_reserve": {"$ref": "#/$defs/rule"},
            "activity_h1": {"$ref": "#/$defs/rule"},
            "holders": {"$ref": "#/$defs/rule"},
            "k_stable": {"$ref": "#/$defs/rule"},
            "authorities": {"$ref": "#/$defs/rule"}
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dexId", "pairAddress", "pairCreatedAt", "pair_created_at_s", "age_s", "graduated_pump",
        "liquidity_quote", "liquidity_base", "sol", "token", "k", "reserve_error", "txns_h1",
        "holders", "holders_truncated", "top10_ex_pool", "dev_pct", "mint_authority", "freeze_authority",
        "score_normalised", "boost_window"
      ],
      "properties": {
        "dexId": {"type": ["string", "null"], "maxLength": 32},
        "pairAddress": {"type": ["string", "null"], "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"},
        "pairCreatedAt": {"$ref": "#/$defs/num"},
        "pair_created_at_s": {"$ref": "#/$defs/num"},
        "age_s": {"$ref": "#/$defs/num"},
        "graduated_pump": {"type": ["boolean", "null"]},
        "liquidity_quote": {"$ref": "#/$defs/num"},
        "liquidity_base": {"$ref": "#/$defs/num"},
        "sol": {"$ref": "#/$defs/num"},
        "token": {"$ref": "#/$defs/num"},
        "k": {"$ref": "#/$defs/num"},
        "reserve_error": {"type": ["string", "null"], "maxLength": 32},
        "txns_h1": {"type": ["object", "null"], "additionalProperties": {"type": ["number", "null"]}},
        "holders": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pct", "excluded", "is_creator"],
            "properties": {
              "pct": {"type": "number"},
              "excluded": {"type": "boolean"},
              "is_creator": {"type": "boolean"}
            }
          }
        },
        "holders_truncated": {"type": "boolean"},
        "top10_ex_pool": {"$ref": "#/$defs/num"},
        "dev_pct": {"$ref": "#/$defs/num"},
        "mint_authority": {"enum": ["revoked", "set", null]},
        "freeze_authority": {"enum": ["revoked", "set", null]},
        "score_normalised": {"$ref": "#/$defs/num"},
        "boost_window": {"type": ["boolean", "null"]}
      }
    }
  }
}
