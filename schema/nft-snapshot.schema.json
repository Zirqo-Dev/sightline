{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zirqo-dev.github.io/sightline/schema/nft-snapshot.schema.json",
  "title": "NFT snapshot pilot row",
  "description": "Derived NH-04 row or the run status. No raw OpenSea body, no wallet, no handle.",
  "oneOf": [{ "$ref": "#/$defs/unit" }, { "$ref": "#/$defs/status" }],
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "asset_id", "chain", "asset_type", "contract", "slug",
        "snapshot_t", "filled_at", "commit_sha", "rule", "seasoned", "fill", "unsellable",
        "cost", "entry_eth", "exit_eth", "gas_eth", "buyer_fee_eth", "marketplace_fee_rate",
        "creator_fee_rate", "floor_eth", "floor_usd", "counts", "top_buyer_share", "attribution"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "unit" },
        "asset_id": { "type": "string", "pattern": "^nft_collection:eip155:(1|8453):0x[0-9a-f]{40}$" },
        "chain": { "enum": ["eip155:1", "eip155:8453"] },
        "asset_type": { "const": "nft_collection" },
        "contract": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
        "slug": { "type": "string", "maxLength": 120 },
        "snapshot_t": { "type": "string" },
        "filled_at": { "type": "string" },
        "commit_sha": { "type": "string" },
        "rule": { "type": "string" },
        "seasoned": { "type": "boolean" },
        "fill": { "type": "boolean" },
        "unsellable": { "type": "boolean" },
        "cost": { "type": ["number", "null"] },
        "entry_eth": { "type": ["number", "null"] },
        "exit_eth": { "type": ["number", "null"] },
        "gas_eth": { "type": ["number", "null"] },
        "buyer_fee_eth": { "type": "number" },
        "marketplace_fee_rate": { "type": ["number", "null"] },
        "creator_fee_rate": { "type": ["number", "null"] },
        "floor_eth": { "type": ["number", "null"] },
        "floor_usd": { "type": ["number", "null"] },
        "counts": { "type": "object" },
        "top_buyer_share": { "type": ["number", "null"] },
        "reason": { "type": "string" },
        "attribution": { "type": "string" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "status", "measured", "partial", "ran_at", "commit_sha", "rule",
        "data_branch", "avoids_branch", "opensea_calls", "rate_limit", "floor_passing_this_run",
        "pending", "units", "unsellable_share", "median_cost", "median_cost_seasoned", "pace_median",
        "pace_ready", "nh04_ready", "eth_usd", "raw", "reason", "attribution"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "status" },
        "status": { "enum": ["no_key", "ok", "partial", "error"] },
        "measured": { "type": "boolean" },
        "partial": { "type": "boolean" },
        "ran_at": { "type": "string" },
        "commit_sha": { "type": "string" },
        "rule": { "type": "string" },
        "data_branch": { "const": "nft-data" },
        "avoids_branch": { "const": "desk-data" },
        "opensea_calls": { "type": "integer", "minimum": 0 },
        "rate_limit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit", "remaining", "reset"],
          "properties": {
            "limit": { "type": ["string", "null"] },
            "remaining": { "type": ["string", "null"] },
            "reset": { "type": ["string", "null"] }
          }
        },
        "floor_passing_this_run": { "type": ["integer", "null"] },
        "pending": { "type": ["integer", "null"] },
        "units": { "type": ["integer", "null"] },
        "unsellable_share": { "type": ["number", "null"] },
        "median_cost": { "type": ["number", "null"] },
        "median_cost_seasoned": { "type": ["number", "null"] },
        "pace_median": { "type": ["number", "null"] },
        "pace_ready": { "type": "boolean" },
        "nh04_ready": { "type": "boolean" },
        "eth_usd": { "type": ["number", "null"] },
        "raw": { "enum": ["skipped", "dropped", "pushed", "refused", "error"] },
        "reason": { "type": ["string", "null"] },
        "attribution": { "type": "string" }
      }
    }
  }
}
