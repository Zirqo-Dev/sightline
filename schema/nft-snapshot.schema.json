{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zirqo-dev.github.io/sightline/schema/nft-snapshot.schema.json",
  "title": "NFT snapshot pilot row",
  "description": "Derived NH-04 row or the run status. No raw OpenSea body, no wallet, no handle.",
  "oneOf": [{ "$ref": "#/$defs/unit" }, { "$ref": "#/$defs/status" }],
  "$defs": {
    "chain_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screened", "passing"],
      "properties": {
        "screened": { "type": "integer", "minimum": 0 },
        "passing": { "type": "integer", "minimum": 0 }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "asset_id", "chain", "asset_type", "contract", "slug",
        "snapshot_t", "filled_at", "commit_sha", "rule", "seasoned", "fill", "unsellable",
        "cost", "entry_eth", "exit_eth", "gas_eth", "buyer_fee_eth", "marketplace_fee_rate",
        "creator_fee_rate", "floor_eth", "floor_usd", "counts", "top_buyer_share", "attribution"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "unit" },
        "asset_id": { "type": "string", "pattern": "^nft_collection:eip155:(1|8453):0x[0-9a-f]{40}$" },
        "chain": { "enum": ["eip155:1", "eip155:8453"] },
        "asset_type": { "const": "nft_collection" },
        "contract": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
        "slug": { "type": "string", "maxLength": 120 },
        "snapshot_t": { "type": "string" },
        "filled_at": { "type": "string" },
        "commit_sha": { "type": "string" },
        "rule": { "type": "string" },
        "seasoned": { "type": "boolean" },
        "fill": { "type": "boolean" },
        "unsellable": { "type": "boolean" },
        "cost": { "type": ["number", "null"] },
        "entry_eth": { "type": ["number", "null"] },
        "exit_eth": { "type": ["number", "null"] },
        "gas_eth": { "type": ["number", "null"] },
        "buyer_fee_eth": { "type": "number" },
        "marketplace_fee_rate": { "type": ["number", "null"] },
        "creator_fee_rate": { "type": ["number", "null"] },
        "floor_eth": { "type": ["number", "null"] },
        "floor_usd": { "type": ["number", "null"] },
        "counts": { "type": "object" },
        "top_buyer_share": { "type": ["number", "null"] },
        "reason": { "type": "string" },
        "attribution": { "type": "string" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "status", "measured", "partial", "ran_at", "commit_sha", "rule",
        "data_branch", "avoids_branch", "opensea_calls", "rate_limit", "floor_passing_this_run",
        "pending", "units", "unsellable_share", "median_cost", "median_cost_seasoned",
        "null_cost_count", "null_cost_share", "null_cost_share_max", "pace_median",
        "pace_ready", "nh04", "nh04_ready", "buyer_fee_eth", "eth_usd", "raw", "reason", "rejections",
        "flags", "screened", "pending_served", "pending_deferred", "passers_footnoted",
        "nh04_verdict", "verdict_footnote", "distinct_collections", "distinct_per_day_median",
        "early_kill", "stop", "by_chain", "attribution"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "status" },
        "status": { "enum": ["no_key", "ok", "partial", "error"] },
        "measured": { "type": "boolean" },
        "partial": { "type": "boolean" },
        "ran_at": { "type": "string" },
        "commit_sha": { "type": "string" },
        "rule": { "type": "string" },
        "data_branch": { "const": "nft-data" },
        "avoids_branch": { "const": "desk-data" },
        "opensea_calls": { "type": "integer", "minimum": 0 },
        "rate_limit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit", "remaining", "reset"],
          "properties": {
            "limit": { "type": ["string", "null"] },
            "remaining": { "type": ["string", "null"] },
            "reset": { "type": ["string", "null"] }
          }
        },
        "floor_passing_this_run": { "type": ["integer", "null"] },
        "pending": { "type": ["integer", "null"] },
        "units": { "type": ["integer", "null"] },
        "unsellable_share": { "type": ["number", "null"] },
        "median_cost": { "type": ["number", "null"] },
        "median_cost_seasoned": { "type": ["number", "null"] },
        "null_cost_count": { "type": ["integer", "null"], "minimum": 0 },
        "null_cost_share": { "type": ["number", "null"] },
        "null_cost_share_max": { "const": 0.2 },
        "pace_median": { "type": ["number", "null"] },
        "pace_ready": { "type": "boolean" },
        "nh04": { "enum": ["ready", "not_ready"] },
        "nh04_ready": { "type": "boolean" },
        "buyer_fee_eth": { "const": 0 },
        "eth_usd": { "type": ["number", "null"] },
        "raw": { "const": "not_kept" },
        "reason": { "type": ["string", "null"] },
        "rejections": {
          "description": "How many times each rejection reason was hit. Not a count of collections: one collection can increment several reasons.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contracts", "shared", "standard", "mint", "disabled", "floor", "gas",
            "listings", "sales", "buyers", "bidders", "concentration"
          ],
          "properties": {
            "contracts": { "type": "integer", "minimum": 0 },
            "shared": { "type": "integer", "minimum": 0 },
            "standard": { "type": "integer", "minimum": 0 },
            "mint": { "type": "integer", "minimum": 0 },
            "disabled": { "type": "integer", "minimum": 0 },
            "floor": { "type": "integer", "minimum": 0 },
            "gas": { "type": "integer", "minimum": 0 },
            "listings": { "type": "integer", "minimum": 0 },
            "sales": { "type": "integer", "minimum": 0 },
            "buyers": { "type": "integer", "minimum": 0 },
            "bidders": { "type": "integer", "minimum": 0 },
            "concentration": { "type": "integer", "minimum": 0 }
          }
        },
        "flags": {
          "description": "v0.3 counts that are never rejections. sales_truncated: more than 300 sales in 7 days (buyers and share computed on the sample). liquid_tail: truncated collections that passed.",
          "type": "object",
          "additionalProperties": false,
          "required": ["sales_truncated", "liquid_tail"],
          "properties": {
            "sales_truncated": { "type": "integer", "minimum": 0 },
            "liquid_tail": { "type": "integer", "minimum": 0 }
          }
        },
        "screened": { "type": ["integer", "null"], "minimum": 0 },
        "pending_served": { "type": ["integer", "null"], "minimum": 0 },
        "pending_deferred": { "type": ["integer", "null"], "minimum": 0 },
        "passers_footnoted": { "type": ["integer", "null"], "minimum": 0 },
        "nh04_verdict": {
          "description": "A v0.3 GO is never plain GO: it reads 'cost GO, supply-limited (median N distinct/day)'.",
          "type": "string",
          "pattern": "^(not_ready|INCONCLUSIVE|NO-GO|cost GO, supply-limited \\(median [0-9.na/]+ distinct/day\\))$"
        },
        "verdict_footnote": { "type": ["string", "null"] },
        "stop": {
          "description": "Why a measured screen ended. Null on partial runs (list error, deferred pending, no eth price, gas failure).",
          "enum": [null, "pass_target", "depth", "call_cap", "deadline"]
        },
        "by_chain": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "ethereum": { "$ref": "#/$defs/chain_counts" },
            "base": { "$ref": "#/$defs/chain_counts" }
          }
        },
        "distinct_collections": { "type": ["integer", "null"], "minimum": 0 },
        "distinct_per_day_median": { "type": ["number", "null"] },
        "early_kill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gate1", "gate1_runs", "gate1_avg", "gate1_min_avg", "gate2", "gate2_distinct", "gate2_min_distinct",
                       "gate2_window_hours", "backstop", "backstop_measured_days", "backstop_min_days", "result"],
          "properties": {
            "gate1": { "enum": ["pending", "pass", "fire"] },
            "gate1_runs": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "maxItems": 3 },
            "gate1_avg": { "type": ["number", "null"] },
            "gate1_min_avg": { "const": 6 },
            "gate2": { "enum": ["pending", "pass", "fire"] },
            "gate2_distinct": { "type": "integer", "minimum": 0 },
            "gate2_min_distinct": { "const": 8 },
            "gate2_window_hours": { "const": 72 },
            "backstop": { "enum": ["pending", "pass", "fire"] },
            "backstop_measured_days": { "type": "integer", "minimum": 0 },
            "backstop_min_days": { "const": 4 },
            "result": { "enum": [null, "STOPPED", "INCONCLUSIVE"] }
          }
        },
        "attribution": { "type": "string" }
      }
    }
  }
}
