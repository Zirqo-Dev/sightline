{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zirqo-dev.github.io/sightline/schema/paper-book.schema.json",
  "title": "Sightline paper book v2",
  "type": "object",
  "required": ["schema_version", "desk", "book", "open", "closed", "rules"],
  "properties": {
    "schema_version": {"const": 2},
    "desk": {"type": "string"},
    "book": {"type": "string"},
    "chain": {"type": "string"},
    "unit": {"type": "string"},
    "disclaimer": {"type": "string"},
    "ticket_size": {"type": "number"},
    "default_window_hours": {"type": "number"},
    "levels": {"type": "object"},
    "open": {"type": "array", "items": {"$ref": "#/$defs/ticket"}},
    "closed": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/ticket"}, {"required": ["closed_at"]}]}},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "summaries": {"type": "array", "items": {"type": "object", "properties": {"at": {"type": "string"}, "type": {"type": "string"}, "note": {"type": "string"}}}}
  },
  "additionalProperties": true,
  "$defs": {
    "ticket": {
      "type": "object",
      "required": ["id", "ticker", "opened_at"],
      "properties": {
        "id": {"type": "string"},
        "ticker": {"type": "string"},
        "name": {"type": "string"},
        "status": {"type": "string"},
        "opened_at": {"type": "string"},
        "window_ends_at": {"type": "string"},
        "closed_at": {"type": "string"},
        "level": {"type": "number"},
        "size": {"type": "number"},
        "entry": {"type": "object"},
        "exit": {"type": "object"},
        "exit_reason": {"type": "string"},
        "kill_line": {"type": ["object", "string"]},
        "thesis": {"type": ["array", "string"]},
        "marks": {"type": "array"},
        "result": {"type": "object", "properties": {"pnl": {"type": "number"}, "pct": {"type": "number"}, "unit": {"type": "string"}}},
        "review": {},
        "entry_sol_reserve": {"type": ["number", "null"]},
        "entry_token_reserve": {"type": ["number", "null"]},
        "entry_k": {"type": ["number", "null"]},
        "entry_reserve_error": {"type": ["string", "null"]},
        "exit_sol_reserve": {"type": ["number", "null"]},
        "exit_token_reserve": {"type": ["number", "null"]},
        "exit_k": {"type": ["number", "null"]},
        "exit_reserve_error": {"type": ["string", "null"]},
        "last_sol_reserve": {"type": ["number", "null"]},
        "last_token_reserve": {"type": ["number", "null"]},
        "last_k": {"type": ["number", "null"]},
        "last_reserve_error": {"type": ["string", "null"]},
        "reserve_snaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["t", "sol", "token", "k"],
            "properties": {
              "t": {"type": "string"},
              "sol": {"type": ["number", "null"]},
              "token": {"type": ["number", "null"]},
              "k": {"type": ["number", "null"]},
              "error": {"type": "string"}
            }
          }
        },
        "pool_created_at": {"type": ["string", "null"]},
        "graduated_pump": {"type": ["boolean", "null"]},
        "boost_window": {"type": ["boolean", "null"]},
        "entry_quote_out": {"type": ["number", "null"]},
        "entry_quote_px": {"type": ["number", "null"]},
        "entry_quote_impact": {"type": ["number", "null"]},
        "entry_quote_error": {"type": ["string", "null"]},
        "exit_quote_out": {"type": ["number", "null"]},
        "exit_quote_px": {"type": ["number", "null"]},
        "exit_quote_impact": {"type": ["number", "null"]},
        "exit_quote_error": {"type": ["string", "null"]},
        "max_price_held": {"type": ["number", "null"]},
        "min_price_held": {"type": ["number", "null"]},
        "max_price_held_pct": {"type": ["number", "null"]},
        "min_price_held_pct": {"type": ["number", "null"]}
      },
      "additionalProperties": true
    },
    "rule": {
      "type": "object",
      "required": ["rule"],
      "properties": {
        "id": {"type": "string"},
        "added_at": {"type": "string"},
        "rule": {"type": "string"},
        "source": {"type": "string"},
        "title": {"type": "string"},
        "category": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "mirrors": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
