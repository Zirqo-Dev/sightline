{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zirqo-dev.github.io/sightline/schema/brief.schema.json",
  "title": "Sightline daily brief v2",
  "type": "object",
  "required": ["schema_version", "desk", "date", "headline"],
  "properties": {
    "schema_version": {"const": 2},
    "desk": {"type": "string"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "headline": {"type": "string"},
    "scoreboard": {"type": "object", "properties": {"open": {"type": "number"}, "closed": {"type": "number"}, "wins": {"type": "number"}, "losses": {"type": "number"}, "pnl": {"type": "number"}, "unit": {"type": "string"}}},
    "highlights": {"type": "array"},
    "rules_learned": {"type": "array"},
    "next_watch": {"type": "array"}
  },
  "additionalProperties": true
}
